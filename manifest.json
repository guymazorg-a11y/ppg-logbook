{
  "name": "יומן מנוע – מצנח ממונע",
  "short_name": "יומן מנוע",
  "description": "מעקב שעות מנוע, טיסות ותחזוקה עם גיבוי לאקסל",
  "lang": "he",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f1419",
  "theme_color": "#0f1419",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "track", "accept": [".igc", ".gpx", ".IGC", ".GPX", "application/octet-stream", "text/plain", "application/gpx+xml", "application/xml", "text/xml", "*/*"] }]
    }
  },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
